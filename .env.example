APP_ENV=development
DEBUG=false
MAX_UPLOAD_SIZE=52428800
MAX_PDF_PAGES=300
MAX_RENDER_DPI=300
PDF_STORAGE_DIR=./backend/temp_storage
PDF_DATABASE_PATH=./backend/temp_storage/history.sqlite3
FILE_RETENTION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional absolute path when LibreOffice is not available on PATH:
LIBREOFFICE_PATH=
